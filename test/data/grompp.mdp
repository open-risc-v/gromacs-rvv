integrator      = md
dt              = 0.002
nsteps          = 20
cutoff-scheme   = Verlet
nstlist         = 5
coulombtype     = reaction-field
rcoulomb        = 0.9
rvdw            = 0.9
constraints     = h-bonds
continuation    = no
gen-vel         = yes
gen-temp        = 300
tcoupl          = no
pcoupl          = no
nstxout         = 20
nstvout         = 20
nstenergy       = 1
gen-seed        = 1234
